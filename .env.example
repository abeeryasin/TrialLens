# The Neon branch this env points at. `production` is the real, live database
# (renamed from `dev` on 2026-09-05 — see docs/decisions.md); `sandbox` is the
# disposable copy to point at when testing anything destructive. Get a sandbox
# URL with:
#   npx neon@latest connection-string sandbox --role-name neondb_owner --pooled
NEON_BRANCH=production
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
# SELECT-only role, generated by scripts/create_readonly_role.py — used by
# every FastAPI GET endpoint. Never grant this role write access.
DATABASE_URL_READONLY=postgresql://trial_lens_reader:password@host/dbname?sslmode=require
